{
  "name": "@sciflow/desktop",
  "version": "1.19.12",
  "private": true,
  "description": "SciFlow 桌面端（Electron 封装：内嵌 NestJS 后端 + 本地 SQLite，离线可用）",
  "desktopName": "SciFlow",
  "main": "dist-electron/main.js",
  "author": "SciFlow Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Morningstar202604/sciflow.git"
  },
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "prepare:resources": "pnpm build:web && node scripts/prepare-server.mjs",
    "prepare:resources:win": "pnpm build:web && node scripts/prepare-server.mjs --platform=win32 --arch=x64",
    "prepare:resources:linux": "pnpm build:web && node scripts/prepare-server.mjs --platform=linux --arch=x64",
    "prepare:resources:mac": "pnpm build:web && node scripts/prepare-server.mjs --platform=darwin --arch=arm64",
    "dev": "pnpm build:main && electron .",
    "dist": "pnpm build:main && pnpm prepare:resources && electron-builder --publish never",
    "dist:dir": "electron-builder --win --dir --publish never",
    "dist:win": "pnpm build:main && pnpm prepare:resources:win && electron-builder --win --publish never",
    "dist:mac": "pnpm build:main && pnpm prepare:resources:mac && electron-builder --mac --publish never",
    "dist:linux": "pnpm build:main && pnpm prepare:resources:linux && electron-builder --linux --publish never",
    "build:web": "pnpm --filter @sciflow/web exec vite build --base=./ --outDir dist-desktop",
    "test": "pnpm --filter @sciflow/server exec vitest run --config ../../apps/server/vitest.config.mts ../desktop/src"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "electron": "42.11.18",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3"
  }
}

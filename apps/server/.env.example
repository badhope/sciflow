# ============================================
# SciFlow 后端环境变量（复制为 .env 后填写）
# cp apps/server/.env.example apps/server/.env
# ============================================

# 后端端口
PORT=3000

# SQLite 数据库文件路径（默认 apps/server/data/sciflow.db）
# DATABASE_PATH=./data/sciflow.db

# ------------------------------------------------------------
# AI 服务配置（OpenAI 兼容协议，默认豆包·火山方舟，国内厂商任选其一）：
#   豆包      https://ark.cn-beijing.volces.com/api/v3 + 火山方舟 Key（默认）
#   DeepSeek  https://api.deepseek.com/v1  + DeepSeek Key
#   通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1 + 阿里云 DashScope Key
#   智谱      https://open.bigmodel.cn/api/paas/v4 + 智谱 Key
#   Kimi      https://api.moonshot.cn/v1 + Moonshot Key
# ------------------------------------------------------------
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_API_KEY=sk-your-api-key-here
# 模型路由：fast=轻量快速（默认），strong=强模型（长文起草/评审/规划）
AI_MODEL_FAST=
AI_MODEL_STRONG=
AI_MODEL=（必填：替换为你在所选厂商开通的模型名，如 doubao-seed-1-6 / deepseek-chat / qwen-plus）
# 协议：openai-compatible（默认）/ anthropic-messages / google-gemini
# 也可留空，直接在设置 → 模型路由里填地址+Key（自动检测模型与能力）
# AI_PROTOCOL=openai-compatible
# 免费版 RPM 限流额度（每分钟最多 N 次 AI 调用，令牌桶排队，稳定防 429）
AI_RPM_CAP=8

# 1=进程内 mock 网关（无 Key / 无外网跑通全链路；仅测试与演示，不代表真实模型能力）
# AI_MOCK=0

# CORS 允许来源（逗号分隔；* 全放行）。默认仅放行本地前端 :5173
# CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# ------------------------------------------------------------
# 企业认证（默认 none：本地/桌面单用户零登录；jwt：全 API 强制 Bearer Token）
# 生产部署开启 jwt 时必须显式设置 JWT_SECRET（不要用默认值）
#   AUTH_MODE=jwt
#   JWT_SECRET=请替换为足够长的随机字符串
#   JWT_EXPIRES=7d
# 前端会自动出现登录门；首位注册用户自动成为管理员（admin）
#
# 安全约束（2026-10 审计后强制）：
#  - AUTH_MODE=jwt 时 JWT_SECRET 必须 ≥32 字符，否则**拒绝启动**（不再回退到默认口令）
#    生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#  - 注册默认只在空库首次可用；需要开放注册时显式设置 ALLOW_REGISTRATION=1
# ------------------------------------------------------------
AUTH_MODE=none
JWT_SECRET=
JWT_EXPIRES=7d
# ALLOW_REGISTRATION=1

# ------------------------------------------------------------
# 出站请求白名单（SSRF 防护）
# 默认拒绝访问回环/私有网段/云元数据地址。本地自建 SearXNG 或内网 MCP 时显式放开：
#   ALLOW_PRIVATE_OUTBOUND=1
# ------------------------------------------------------------
# ALLOW_PRIVATE_OUTBOUND=1

# ============================================================
# 以下为可选高级项，默认值通常即可；需要调优时取消注释
# ============================================================

# ---------- 主密钥（模型 API Key 落库前的加密密钥） ----------
# 不设则自动在数据库同目录生成 .sciflow.key（0600）。生产/容器建议显式注入，
# 这样重建数据卷不会导致库内已存 Key 无法解密。
# SCIFLOW_SECRET=

# ---------- 日志 ----------
# LOG_LEVEL=fatal|error|warn|info|debug|trace
# LOG_LEVEL=info
# 1=开发用彩色单行日志（默认生产为 JSON）
# LOG_PRETTY=0

# ---------- 请求体上限（知识库 PDF 走 base64 JSON，与 nginx client_max_body_size 对齐） ----------
# BODY_LIMIT=64mb

# ---------- 流水线性能 ----------
# 分章起草并发数（受 AI_RPM_CAP 约束，过大反而触发 429）
# AI_DRAFT_CONCURRENCY=3

# ---------- Agent 工具链 ----------
# off=关闭模型工具调用；默认开启
# AGENT_TOOLS=on
# 允许暴露给模型的工具白名单（逗号分隔）
# AGENT_TOOLS_ALLOW=literature.search,literature.summarize,knowledge.query,outline.generate,writing.polish,writing.translate,writing.review,references.extract,references.evidence,chat.answer
# 单轮最多工具调用次数 / 单次工具超时（毫秒）
# AGENT_MAX_TOOL_CALLS=8
# AGENT_TOOL_TIMEOUT_MS=20000

# ---------- 模型传输兼容 ----------
# 某些 OpenAI 兼容端点会把流式 tool_calls 写成正文文本，需要非流式回退。
# on=全部非流式 / off=全部流式 / 不设=仅对下列主机回退
# AI_TOOLS_NONSTREAM=
# AI_TOOLS_NONSTREAM_HOSTS=hcnsec.cn

# ---------- 检索 ----------
# on=启用 LLM 重排（更准但更慢更贵，默认 off）
# RETRIEVAL_RERANK=off
# 注入对话的单条知识片段字符数（下限 200）
# KNOWLEDGE_SNIPPET_CHARS=800
# 1=禁用 sqlite-vec（仅 FTS5 全文检索；用于排查原生扩展问题）
# SCIFLOW_NO_VEC=0

# ---------- 嵌入后端（向量检索用）----------
# auto（默认）= 有 GGUF 走 local，否则 AI 已配置则走厂商 /embeddings；local / api / none 可强制
# EMBEDDING_PROVIDER=auto
# 远程嵌入模型名（EMBEDDING_PROVIDER=api 时；不设则用当前 chat 模型名，多数厂商需显式指定）
# EMBEDDING_API_MODEL=text-embedding-3-small
# 本地 GGUF 模型路径（须为 384 维，与 vec0 表一致）；不设则用默认缓存位置
# EMBEDDING_MODEL_PATH=
# 模型缓存目录（默认 $HOME/.sciflow/models）
# SCIFLOW_MODEL_CACHE=

# ---------- 实验沙箱 ----------
# Python 解释器路径（不设则自动探测 python3/python）
# SANDBOX_PYTHON=
# 脚本执行超时（毫秒）
# SANDBOX_TIMEOUT_MS=10000

# ---------- 网搜 Provider（也可在设置页配置，DB 优先于环境变量） ----------
# WEBSEARCH_PROVIDER=duckduckgo|searxng|tavily|serper|brave
# WEBSEARCH_SEARXNG_URL=
# WEBSEARCH_TAVILY_KEY=
# WEBSEARCH_SERPER_KEY=
# WEBSEARCH_BRAVE_KEY=
# on=对话中允许联网兜底（默认 off）
# WEBSEARCH_IN_CHAT=off


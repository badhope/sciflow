{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "rootDir": "../..",
    /* msw 走 exports 子路径（node10 解析读不到 map）；TS 层显式桥接，运行时仍由 Node exports 解析 */
    "paths": {
      "@sciflow/core/*": ["../../packages/core/src/*"],
      "@sciflow/db/*": ["../../packages/db/src/*"],
      "@sciflow/core": ["../../packages/core/src/index.ts"],
      "@sciflow/db": ["../../packages/db/src/index.ts"],
      "better-sqlite3": ["./node_modules/better-sqlite3"],
      "sqlite-vec": ["./node_modules/sqlite-vec"],
      "drizzle-orm/*": ["./node_modules/drizzle-orm/*"],
      "@nestjs/common": ["./node_modules/@nestjs/common"],
      "drizzle-orm": ["./node_modules/drizzle-orm"],
      "ai": ["./node_modules/ai"],
      "@ai-sdk/openai-compatible": ["./node_modules/@ai-sdk/openai-compatible"],
      "@ai-sdk/anthropic": ["./node_modules/@ai-sdk/anthropic"],
      "@ai-sdk/google": ["./node_modules/@ai-sdk/google"],
      "zod": ["./node_modules/zod"],
      "jsonrepair": ["./node_modules/jsonrepair"],
      "p-limit": ["./node_modules/p-limit"],
      "p-retry": ["./node_modules/p-retry"],
      "msw": ["./node_modules/msw/lib/core/index.d.ts"],
      "msw/node": ["./node_modules/msw/lib/node/index.d.ts"],
      "@langchain/textsplitters": ["./node_modules/@langchain/textsplitters"],
      "unpdf": ["./node_modules/unpdf"],
      "node-llama-cpp": ["./node_modules/node-llama-cpp"],
      "undici": ["./node_modules/undici"],
      "msw/http": ["./node_modules/msw/lib/http/index.d.ts"]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": false
  },
  "include": ["src/**/*", "../../packages/core/src/**/*", "../../packages/db/src/**/*", "../../packages/ai/src/**/*", "../../packages/retrieval/src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
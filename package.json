{
  "name": "sciflow",
  "version": "1.19.16",
  "private": true,
  "description": "Local-first research workbench for literature, writing, review, and submission, with a deterministic quality gate and traceable citations.",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @sciflow/server dev\" \"pnpm --filter @sciflow/web dev\"",
    "dev:server": "pnpm --filter @sciflow/server dev",
    "dev:web": "pnpm --filter @sciflow/web dev",
    "desktop:dev": "pnpm --filter @sciflow/desktop dev",
    "desktop:dist": "pnpm --filter @sciflow/desktop dist",
    "build": "pnpm -r build",
    "start": "pnpm --filter @sciflow/server start",
    "db:push": "pnpm --filter @sciflow/server db:push",
    "db:studio": "pnpm --filter @sciflow/server db:studio",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "eval:prompts": "promptfoo eval -c evals/promptfooconfig.yaml",
    "test:agent-eval": "pnpm --filter @sciflow/server exec vitest run src/eval/agent-task-eval.spec.ts",
    "format": "prettier --write .",
    "openapi:gen": "pnpm --filter @sciflow/server build && node scripts/openapi-gen.mjs",
    "openapi:check": "pnpm openapi:gen && git diff --exit-code -- openapi.json apps/web/src/api/openapi.d.ts",
    "icons": "node scripts/generate-icons.mjs",
    "backup": "node scripts/backup-db.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify:jwt": "node scripts/verify-jwt-access.mjs",
    "test:api": "node scripts/api-coverage.mjs",
    "capture:ui": "node scripts/capture-ui.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.7.0",
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/google": "4.0.93",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@nestjs/common": "^11.2.6",
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vitest/coverage-v8": "5.0.4",
    "ai": "^7.0.137",
    "better-sqlite3": "12.11.1",
    "concurrently": "^10.0.5",
    "drizzle-orm": "0.45.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsonrepair": "^3.15.0",
    "msw": "^3.0.3",
    "p-limit": "^7.3.3",
    "p-retry": "^9.0.0",
    "prettier": "^3.9.10",
    "promptfoo": "^0.126.0",
    "sqlite-vec": "0.1.9",
    "typescript-eslint": "^8.71.2",
    "undici": "^8.12.4",
    "zod": "^4.6.6"
  },
  "homepage": "https://badhope.github.io/sciflow/",
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/badhope/sciflow.git"
  }
}

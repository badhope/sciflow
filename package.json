{
  "name": "sciflow",
  "version": "1.15.1",
  "private": true,
  "description": "SciFlow - 从选题到可投稿稿件的科研工作台：确定性质量门、引用三级可追溯、可复现流水线",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @sciflow/server dev\" \"pnpm --filter @sciflow/web dev\"",
    "dev:server": "pnpm --filter @sciflow/server dev",
    "dev:web": "pnpm --filter @sciflow/web dev",
    "desktop:dev": "pnpm --filter @sciflow/desktop dev",
    "desktop:dist": "pnpm --filter @sciflow/desktop dist",
    "build": "pnpm -r build",
    "start": "pnpm --filter @sciflow/server start",
    "db:push": "pnpm --filter @sciflow/server db:push",
    "db:studio": "pnpm --filter @sciflow/server db:studio",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "eval:prompts": "promptfoo eval -c evals/promptfooconfig.yaml",
    "format": "prettier --write .",
    "openapi:gen": "pnpm --filter @sciflow/server build && node scripts/openapi-gen.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "backup": "node scripts/backup-db.mjs",
    "doctor": "node scripts/doctor.mjs",
    "verify:jwt": "node scripts/verify-jwt-access.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.7.0",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vitest/coverage-v8": "5.0.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "promptfoo": "^0.125.1",
    "typescript-eslint": "^8.71.2"
  },
  "homepage": "https://badhope.github.io/sciflow/",
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/badhope/sciflow.git"
  }
}
